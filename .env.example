# ============================================================
# ModelAPI 后端环境变量示例
# 复制为 .env 并在运行 node server.js 前 export，或直接写入系统环境变量
# 不配置也能跑：未配置密钥时自动进入「演示仿真模式」
# ============================================================

# 上游 AI 网关（OpenAI 兼容接口）
# 例：https://api.openai.com/v1  或  https://api.siliconflow.cn/v1
UPSTREAM_BASE_URL=

# 上游 API 密钥（仅在你想真正调用模型时填写；务必保密，不要提交到仓库）
UPSTREAM_API_KEY=

# 本地服务端口（可选，默认 3000）
# PORT=3000

# ============================================================
# AI 生图 / 视频生成（调用 aimodelapi.ai 平台）
# 不配置也能跑：未配置密钥时进入「演示模式」
# ============================================================

# 生图平台地址（OpenAI 兼容 images/generations）
IMAGE_BASE_URL=https://api.aimodelapi.ai/v1

# 生图平台 API 密钥（务必保密，不要提交到仓库）
IMAGE_API_KEY=

# 视频生成平台地址（OpenAI 兼容）
VIDEO_BASE_URL=https://api.aimodelapi.ai/v1

# 视频生成平台 API 密钥（务必保密，不要提交到仓库）
VIDEO_API_KEY=

